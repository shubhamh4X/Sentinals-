        "eventId",
        "ownerId",
        "deviceId",
        "hostname",
        "emulator",
        "sessionId",
        "ruleId",
        "ruleVersion",
        "category",
        "severity",
        "classification",
        "confidence",
        "riskContribution",
        "processName",
        "processPath",
        "sha256",
        "signerIdentity",
        "summary",
        "detectionSource",
        "isSimulated",
        "eventTimestamp",
        "createdAt"
      ]
    },
    "IncidentRecord": {
