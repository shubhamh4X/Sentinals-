{
  "entities": {
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator membership document used for zero-trust RBAC verification.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Assigned role level",
          "enum": ["Administrator", "Security Analyst", "Read-Only Viewer"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of role creation"
        }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated SOC user profile with strict PII isolation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["Administrator", "Security Analyst", "Read-Only Viewer"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "MonitoredDevice": {
      "title": "MonitoredDevice",
      "description": "Registered Windows PC endpoint running the Sentinel AC native service.",
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "osVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "agentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["healthy", "degraded", "disconnected", "revoked"]
        },
        "emulatorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "gameSessionState": {
          "type": "string",
          "enum": ["idle", "launching", "active_match", "terminated"]
        },
        "freeFirePackage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "integrityStatus": {
          "type": "string",
          "enum": ["verified", "tamper_suspected", "signature_mismatch"]
        },
        "riskScore": {
          "type": "number"
        },
        "isSimulated": {
          "type": "boolean"
        },
        "lastHeartbeat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "deviceId",
        "ownerId",
        "hostname",
        "osVersion",
        "agentVersion",
        "status",
        "emulatorName",
        "gameSessionState",
        "freeFirePackage",
        "integrityStatus",
        "riskScore",
        "isSimulated",
        "lastHeartbeat",
        "createdAt",
        "updatedAt"
      ]
    },
