  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted administrator directory for RBAC checks."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "SOC analyst and viewer user profiles."
    },
    "/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/MonitoredDevice" },
      "description": "Monitored Windows PC endpoints running Sentinel AC."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/SecurityEventRecord" },
      "description": "Real-time and historical anti-cheat telemetry events."
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/IncidentRecord" },
      "description": "Correlated security incidents and investigation case files."
    },
    "/rules/{ruleId}": {
      "schema": { "$ref": "#/entities/DetectionRuleRecord" },
      "description": "Signed detection rules and threshold configurations."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogRecord" },
      "description": "Immutable security operations audit log."
    },
    "/agent_relay_heartbeats/{deviceId}": {
      "schema": { "$ref": "#/entities/AgentRelayHeartbeat" },
      "description": "Cross-PC Windows agent registration and heartbeat cloud relay."
    },
    "/agent_relay_telemetry/{nonce}": {
      "schema": { "$ref": "#/entities/AgentRelayTelemetry" },
      "description": "Cross-PC Windows agent security telemetry cloud relay."
    }
  }
}
